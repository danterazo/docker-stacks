# General
TZ: America/Chicago

# Speedtest Tracker
DB_CONNECTION: sqlite
PRUNE_RESULTS_OLDER_THAN: 365
DATETIME_FORMAT: "M. j, g:i:s A"
CHART_DATETIME_FORMAT: ${DATETIME_FORMAT}
APP_TIMEZONE: ${TZ}
DISPLAY_TIMEZONE: ${TZ}
RESULTS_POLLING: 300s
DASHBOARD_POLLING: ${RESULTS_POLLING}
NOTIFICATION_POLLING: ${RESULTS_POLLING}
SPEEDTEST_PING_URL: 1.1.1.1
