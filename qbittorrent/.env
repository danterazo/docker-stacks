# common config
TZ: America/Chicago

# qbittorrent UI & mod
WEBUI_PORT: 8090 # required if using non-standard port (default 8080)
DOCKER_MODS: ghcr.io/t-anc/gsp-qbittorent-gluetun-sync-port-mod:main
GSP_SLEEP: 120
GSP_MINIMAL_LOGS: false
GSP_GTN_ADDR: http://localhost:8000
GSP_QBT_ADDR: http://localhost:8090
# UMASK=022
GSP_SKIP_INIT_CHECKS: true

# port mappings
# 8080:8080      WebUI
# 6881:6881/tcp  tcp connection port
# 6881:6881/udp  udp connection port

# proton config for gluetun
VPN_SERVICE_PROVIDER: protonvpn
VPN_TYPE: wireguard

# optional
HTTPPROXY: off
SHADOWSOCKS: off
DNS_SERVER: off
DNS_UPSTREAM_RESOLVER_TYPE: plain
DNS_UPSTREAM_PLAIN_ADDRESSES: 10.2.0.1:53

# port fowarding
PORT_FORWARD_ONLY: on
VPN_PORT_FORWARDING: on

# gluetun specific
UPDATER_PERIOD: 0
WIREGUARD_IMPLEMENTATION: auto

# notes
# TCP 8090=qBittorrent Web UI
# TCP 8091=qBittorrent Web UI w/ OAuth
