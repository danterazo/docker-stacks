global_defs {
  default_interface ${KEEPALIVED_INTERFACE}
  script_user root
  enable_script_security
}

vrrp_script check_caddy {
  script "/bin/sh /etc/keepalived/check-caddy.sh"
  interval 3
  timeout 5
  fall 2
  rise 2
  init_fail
}

vrrp_instance VI_1 {
  interface ${KEEPALIVED_INTERFACE}
  state ${KEEPALIVED_STATE}
  virtual_router_id ${KEEPALIVED_ROUTER_ID}
  priority ${KEEPALIVED_PRIORITY}
  advert_int 1
  nopreempt

  unicast_peer {
    ${KEEPALIVED_UNICAST_PEERS}
  }

  virtual_ipaddress {
    ${KEEPALIVED_VIRTUAL_IPS}
  }

  authentication {
    auth_type PASS
    auth_pass ${KEEPALIVED_PASSWORD}
  }

  track_script {
    check_caddy
  }

  ${KEEPALIVED_NOTIFY}
}
