# General
TZ: America/Chicago

# keepalived
KEEPALIVED_INTERFACE: eth0
KEEPALIVED_VIRTUAL_IPS: 192.168.40.203/16
KEEPALIVED_ROUTER_ID: 52

# tailscale
TS_STATE_DIR: /var/lib/tailscale
TS_USERSPACE: "true"
TS_AUTH_ONCE: "true"
TS_ACCEPT_DNS: "false"
TS_EXTRA_ARGS: --accept-routes=false --advertise-tags=tag:container
TS_ENABLE_HEALTH_CHECK: "true"
TS_LOCAL_ADDR_PORT: 127.0.0.1:9002
TS_BOOT_TIMEOUT: 1h
TS_SERVE_CONFIG: /etc/tailscale/serve.json
TS_EXPERIMENTAL_SERVICE_AUTO_ADVERTISEMENT: "false"
TS_SERVICE_NAME: svc:caddy
TS_SERVICE_EXTRA_PORT: "8080"
