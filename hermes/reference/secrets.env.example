# Generate with: openssl rand -hex 32
API_SERVER_KEY=replace-with-a-random-64-character-hex-key

# Create a public OAuth client in Pocket ID with authorization code + PKCE (S256).
# Add https://hermes.samskeyti.net/auth/callback as an allowed redirect URI.
HERMES_DASHBOARD_OIDC_CLIENT_ID=replace-with-pocket-id-client-id
