# Temporary LAN login; remove these three entries after Pocket ID login is verified.
# Generate each secret with: openssl rand -hex 32
API_SERVER_KEY=replace-with-a-random-64-character-hex-key
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=dante
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-with-a-random-64-character-hex-password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-with-a-random-64-character-hex-secret

# In hermes/.env, set HERMES_DASHBOARD_OIDC_CLIENT_ID to the public client ID
# from Pocket ID. Use authorization code + PKCE (S256) and register
# https://hermes.samskeyti.net/auth/callback as the redirect URI.
