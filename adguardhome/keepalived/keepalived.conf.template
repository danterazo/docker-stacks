global_defs {
  default_interface ${KEEPALIVED_INTERFACE}
  script_user root
  enable_script_security
}

vrrp_script check_dns {
  script "/bin/sh /etc/keepalived/check-dns.sh ${KEEPALIVED_DNS_ADDRESS}"
  interval 3
  timeout 5
  fall 2
  rise 2
  init_fail
}

vrrp_instance VI_1 {
  interface ${KEEPALIVED_INTERFACE}
  state BACKUP
  virtual_router_id ${KEEPALIVED_ROUTER_ID}
  priority ${KEEPALIVED_PRIORITY}
  advert_int 1
  nopreempt

  virtual_ipaddress {
    ${KEEPALIVED_VIRTUAL_IPS}
  }

  authentication {
    auth_type PASS
    auth_pass ${KEEPALIVED_PASSWORD}
  }

  track_script {
    check_dns
  }

  ${KEEPALIVED_NOTIFY}
}
