# General
TZ: America/Chicago

# keepalived
KEEPALIVED_INTERFACE: eth0
KEEPALIVED_VIRTUAL_IPS: 192.168.40.201/16
KEEPALIVED_ROUTER_ID: 51
KEEPALIVED_CONF_TEMPLATE: /etc/keepalived/keepalived.conf.template

# adguardhome-sync
ORIGIN_URL: http://192.168.30.200:80
REPLICA1_URL: http://192.168.30.201:80
REPLICA2_URL: http://192.168.30.202:80
CRON: "*/5 * * * *"
RUN_ON_START: true

# tailscale
TS_STATE_DIR: /var/lib/tailscale
TS_USERSPACE: "false"
TS_AUTH_ONCE: "true"
TS_ACCEPT_DNS: "false"
TS_EXTRA_ARGS: --advertise-tags=tag:container
TS_ENABLE_HEALTH_CHECK: "true"
TS_LOCAL_ADDR_PORT: 127.0.0.1:9002
TS_BOOT_TIMEOUT: 1h
