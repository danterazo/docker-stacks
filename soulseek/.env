# common config
TZ: America/Chicago

# soulseek UI
SLSKD_REMOTE_CONFIGURATION: false # allows configuration via UI. Disable for extra security if sharing instance to internet

# gluetun integration
SLSKD_VPN: true
SLSKD_VPN_PORT_FORWARDING: true
SLSKD_VPN_GLUETUN_URL: http://127.0.0.1:8000
SLSKD_VPN_GLUETUN_TIMEOUT: 5000
SLSKD_VPN_POLLING_INTERVAL: 5000

# proton config for gluetun
VPN_SERVICE_PROVIDER: protonvpn
VPN_TYPE: wireguard

# optional
HTTPPROXY: off
SHADOWSOCKS: off
DNS_SERVER: off
DNS_UPSTREAM_RESOLVER_TYPE: plain
DNS_UPSTREAM_PLAIN_ADDRESSES: 10.2.0.1:53

# port fowarding
PORT_FORWARD_ONLY: on
VPN_PORT_FORWARDING: on

# gluetun specific
UPDATER_PERIOD: 0
WIREGUARD_IMPLEMENTATION: auto

# notes
# TCP 5030=Soulseek Web UI
# TCP 50300=Soulseek Service Port
