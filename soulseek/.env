# common config
TZ: America/Chicago

# soulseek UI
SLSKD_REMOTE_CONFIGURATION: false # allows configuration via UI. Disable for extra security if sharing instance to internet

# gluetun integration
SLSKD_VPN: true
SLSKD_VPN_PORT_FORWARDING: true
SLSKD_VPN_GLUETUN_URL: http://127.0.0.1:8000
SLSKD_VPN_GLUETUN_TIMEOUT: 5000
SLSKD_VPN_POLLING_INTERVAL: 5000
