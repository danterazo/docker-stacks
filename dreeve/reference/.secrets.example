# signs the admin session cookie; any long random string
APP_SECRET=

# bcrypt hash from `docker compose exec dreeve bin/console security:hash-password`;
# keep the single quotes so Compose does not interpolate the `$` characters
ADMIN_PASSWORD_HASH=''

