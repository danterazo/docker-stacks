# General
TZ=America/Chicago

# Permissions
PUID=1000
PGID=1000

# Postgres
POSTGRES_USER=dante
POSTGRES_DB=audiomusedb

# AudioMuse-AI Flask
POSTGRES_HOST=replace-with-server-tailscale-address
POSTGRES_PORT=5432
TEMP_DIR=/app/temp_audio

# AudioMuse-AI Worker
NVIDIA_VISIBLE_DEVICES=0
NVIDIA_DRIVER_CAPABILITIES=compute,utility
USE_GPU_CLUSTERING=true
PER_SONG_MODEL_RELOAD=true
