{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "builtin",
		"source": "ubuntu",
		"printRemaining": true
	},
	"modules": [
		"title",
		"separator",
		"kernel",
		"os",
		"cpu",
		"gpu",
		"separator",
		"memory",
		"uptime",
		"cpuusage",
		"separator",
		"disk",
		"separator",
		{
			"type": "localIP",
			"showAllIps": true,
			"compact": false,
			"showIpv4": true,
			"showIpv6": false
		},
		"separator",
		"break"
	]
}
