# images & guest
DAWARICH_VERSION=1.23.0
PHOTON_VERSION=2.5.0
LAN_BIND_ADDRESS=192.168.30.118
TZ=America/Chicago

# database: keep the archived database name when switching to production
POSTGRES_USER=postgres
POSTGRES_DB=dawarich_development
DATABASE_HOST=dawarich-db
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_NAME=dawarich_development

# application
RAILS_ENV=production
REDIS_URL=redis://dawarich-redis:6379/0
APPLICATION_HOSTS=track.samskeyti.net,192.168.30.118,localhost,127.0.0.1
APPLICATION_PROTOCOL=http
DOMAIN=track.samskeyti.net
TIME_ZONE=America/Chicago
DISTANCE_UNIT=mi
MIN_MINUTES_SPENT_IN_CITY=60
SELF_HOSTED=true
STORE_GEODATA=true
STORAGE_BACKEND=local
RAILS_LOG_TO_STDOUT=true
ALLOW_EMAIL_PASSWORD_REGISTRATION=false
ALLOW_EMAIL_PASSWORD_LOGIN=true

# internal geocoding
PHOTON_API_HOST=dawarich-geo:2322
PHOTON_API_USE_HTTPS=false
PHOTON_API_LANGUAGE=en
