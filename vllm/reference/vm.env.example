# shared runtime
INFERENCE_BIND_ADDRESS: 192.168.30.105
CONTEXT_SIZE: 262144
VIDEO_GID: 44
RENDER_GID: 991
HOME: /state
# The image does not have a passwd entry for UID 1000; PyTorch needs a username.
USER: vllm
XDG_CACHE_HOME: /state/cache

# vllm
VLLM_PORT: 8000
VLLM_MODEL_SOURCE: local
VLLM_MODEL_DIR: language-models/hf_safetensors/btbtyler09/Qwen3.8-27B-GPTQ-4bit
VLLM_SERVED_MODEL_NAME: qwen3.8-27b-gptq
VLLM_TENSOR_PARALLEL_SIZE: 2
VLLM_GPU_MEMORY_UTILIZATION: 0.90
HF_HOME: /state/huggingface
HF_HUB_OFFLINE: 1
VLLM_CACHE_ROOT: /state/vllm
TORCHINDUCTOR_CACHE_DIR: /state/torch
TRITON_CACHE_DIR: /state/triton
VLLM_ROCM_USE_AITER: 0
VLLM_ROCM_USE_AITER_MOE: 0
VLLM_DISABLED_KERNELS: ExllamaLinearKernel,TritonW4A16LinearKernel
VLLM_WORKER_MULTIPROC_METHOD: spawn
VLLM_USE_RDNA2_FA: 1
VLLM_RDNA_FORCE_FP16: 1
VLLM_RDNA_AR: 0
VLLM_USE_V2_MODEL_RUNNER: 1
GPU_MAX_HW_QUEUES: 2
TORCH_BLAS_PREFER_HIPBLASLT: 0
PYTORCH_TUNABLEOP_ENABLED: 0
PYTORCH_TUNABLEOP_HIPBLASLT_ENABLED: 0
NCCL_P2P_DISABLE: 1

# VM-only Flash-Next model paths
FLASH_NEXT_MODEL: /tank/models/language-models/hf_safetensors/wtdcode/Qwen3.8-Flash-Next-AWQ-W4A16
FLASH_NEXT_PLE: /tank/models/language-models/hf_safetensors/primitive-ai/Qwen3.8-Flash-Next-PLE-quant/ples_int4
