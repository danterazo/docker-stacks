# shared runtime
INFERENCE_BIND_ADDRESS: 192.168.30.150
CONTEXT_SIZE: 262144
VIDEO_GID: 44
RENDER_GID: 993
HOME: /state
# The image does not have a passwd entry for UID 1000; PyTorch needs a username.
USER: vllm
XDG_CACHE_HOME: /state/cache

# vllm
VLLM_PORT: 8000
VLLM_API_KEY_NAMES: VLLM_API_KEY_OVEDUR VLLM_API_KEY_KEX VLLM_API_KEY_CERULEAN VLLM_API_KEY_KVEIKUR VLLM_API_KEY_NEOSERVER VLLM_API_KEY_AUDIOMUSE
VLLM_MODEL_SOURCE: local
VLLM_MODEL_DIR: Qwen/Qwen3.5-35B-A3B-GPTQ-Int4
VLLM_SERVED_MODEL_NAME: qwen3.5-35b-a3b
VLLM_TENSOR_PARALLEL_SIZE: 2
VLLM_GPU_MEMORY_UTILIZATION: 0.80
VLLM_REASONING_PARSER: qwen3
VLLM_TOOL_CALL_PARSER: qwen3_coder
HF_HOME: /state/huggingface
HF_HUB_OFFLINE: 1
VLLM_CACHE_ROOT: /state/vllm
TORCHINDUCTOR_CACHE_DIR: /state/torch
TRITON_CACHE_DIR: /state/triton
VLLM_ROCM_USE_AITER: 0
VLLM_ROCM_USE_AITER_MOE: 0
VLLM_DISABLED_KERNELS: ExllamaLinearKernel
VLLM_WORKER_MULTIPROC_METHOD: spawn
VLLM_USE_RDNA2_FA: 1
VLLM_RDNA_FORCE_FP16: 1
VLLM_RDNA_AR: 0
VLLM_USE_V2_MODEL_RUNNER: 1
GPU_MAX_HW_QUEUES: 2
TORCH_BLAS_PREFER_HIPBLASLT: 0
PYTORCH_TUNABLEOP_ENABLED: 0
PYTORCH_TUNABLEOP_HIPBLASLT_ENABLED: 0
NCCL_P2P_DISABLE: 1
