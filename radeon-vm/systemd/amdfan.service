[Unit]
Description=Control Radeon GPU hub fans through the ASUS BMC
After=network-online.target systemd-modules-load.service
Wants=network-online.target

[Service]
Type=notify
User=dante
Environment=HOME=/home/dante
RuntimeDirectory=amdfan
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /docker/radeon-vm/bin/amdfan.py monitor
ExecStopPost=/usr/bin/python3 /docker/radeon-vm/bin/amdfan.py emergency
Restart=no
WatchdogSec=45

[Install]
WantedBy=multi-user.target
