# ignore sensitive files
*.secrets
*oauth2-proxy.cfg
*.credential*

# ignore sensitive files (TODO: remove)
gluetun/data/
gluetun/*/config/
gluetun/oauth2/
gluetun/soulseek/slskd.yml
gluetun/soulseek/db/
radicale/configs/users
cloudflare-ddns/config.json
hivenet/machine-config/machine-id
**/tautulli

# ignore temporary files
*.swp

# ignore trashes
*.filen.trash.local/
*.recycle/
*.Trash-0/

# ignore backups
*.bak*
*/backups/
*.dump

# ignore internal repos
*.git/
*source/

# ignore data backed up elsewhere
*/data/
immich/redis-data/

# ignore ephemeral folders/files
*ephemeral

# ignore state (semi-ephemeral) files
adguardhome/state/

# ignore caches
*__pycache__/

# ignore venvs
*.venv/

# ignore actions
*github-runner/

# ignore unique files
adguardhome/.env
adguardhome/keepalived.env
caddy/keepalived.env

